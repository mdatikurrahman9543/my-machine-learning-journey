X,Y=housing.data,housing.target
X_train,X_test,Y_train,Y_test=train_test_split(X,Y,test_size=0.3,random_state=32)
model=LinearRegression()
model.fit(X_train,Y_train)
print(model.intercept_)
print(model.coef_)

